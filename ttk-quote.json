{
  "name": "Mojaloop Inbound Quote Agreement",
  "test_cases": [
    {
      "id": 1,
      "name": "Quote Request - Alice Smith (Success)",
      "meta": {
        "info": "Send POST /quotes for Alice Smith (0911111111), expect 202 Accepted and PUT /quotes/{id} callback with ILP condition"
      },
      "fileInfo": {
        "path": "ttk-quote.json",
        "labels": ["quotes"]
      },
      "requests": [
        {
          "id": 1,
          "description": "POST /quotes for Alice Smith ($100 USD)",
          "apiVersion": {
            "minorVersion": 1,
            "majorVersion": 1,
            "type": "fspiop",
            "asynchronous": true
          },
          "operationPath": "/quotes",
          "path": "/quotes",
          "method": "post",
          "headers": {
            "FSPIOP-Source": "testingtoolkitdfsp",
            "FSPIOP-Destination": "dfsp-b",
            "Accept": "application/vnd.interoperability.quotes+json;version=1.1",
            "Content-Type": "application/vnd.interoperability.quotes+json;version=1.1",
            "Date": "Wed, 14 Oct 2026 04:00:00 GMT"
          },
          "body": {
            "quoteId": "b51ec534-ee48-4575-b6a9-ead295548001",
            "transactionId": "a1b2c3d4-e5f6-4a5b-8c9d-0e1f2a3b4c5d",
            "payer": {
              "partyIdInfo": {
                "partyIdType": "MSISDN",
                "partyIdentifier": "0988888888",
                "fspId": "testingtoolkitdfsp"
              }
            },
            "payee": {
              "partyIdInfo": {
                "partyIdType": "MSISDN",
                "partyIdentifier": "0911111111",
                "fspId": "dfsp-b"
              }
            },
            "amountType": "SEND",
            "amount": {
              "currency": "USD",
              "amount": "100"
            },
            "transactionType": {
              "scenario": "TRANSFER",
              "initiator": "PAYER",
              "initiatorType": "CONSUMER"
            }
          },
          "url": "http://host.docker.internal:3000",
          "tests": {
            "assertions": [
              {
                "id": 1,
                "description": "Response status to be 202",
                "exec": [
                  "expect(response.status).to.equal(202)"
                ]
              },
              {
                "id": 2,
                "description": "Transfer amount to be 100 USD",
                "exec": [
                  "expect(callback.body.transferAmount.amount).to.equal('100')",
                  "expect(callback.body.transferAmount.currency).to.equal('USD')"
                ]
              },
              {
                "id": 3,
                "description": "Valid 43-character ILP Condition generated",
                "exec": [
                  "expect(callback.body.condition).to.match(/^[A-Za-z0-9_-]{43}$/)"
                ]
              },
              {
                "id": 4,
                "description": "Valid ILP Prepare Packet present",
                "exec": [
                  "expect(callback.body.ilpPacket).to.be.a('string')",
                  "expect(callback.body.ilpPacket.length).to.be.above(0)"
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": 2,
      "name": "Quote Request - Non-existent Payee (Error 3200)",
      "meta": {
        "info": "Send POST /quotes for non-existent payee (0999999999), expect 202 Accepted and PUT /quotes/{id}/error callback"
      },
      "fileInfo": {
        "path": "ttk-quote.json",
        "labels": ["quotes"]
      },
      "requests": [
        {
          "id": 1,
          "description": "POST /quotes for Non-existent Payee",
          "apiVersion": {
            "minorVersion": 1,
            "majorVersion": 1,
            "type": "fspiop",
            "asynchronous": true
          },
          "operationPath": "/quotes",
          "path": "/quotes",
          "method": "post",
          "headers": {
            "FSPIOP-Source": "testingtoolkitdfsp",
            "FSPIOP-Destination": "dfsp-b",
            "Accept": "application/vnd.interoperability.quotes+json;version=1.1",
            "Content-Type": "application/vnd.interoperability.quotes+json;version=1.1",
            "Date": "Wed, 14 Oct 2026 04:00:00 GMT"
          },
          "body": {
            "quoteId": "c62fd645-ff59-5686-c7ba-fbe306659002",
            "transactionId": "b2c3d4e5-f6a7-5b6c-9d0e-1f2a3b4c5d6e",
            "payer": {
              "partyIdInfo": {
                "partyIdType": "MSISDN",
                "partyIdentifier": "0988888888",
                "fspId": "testingtoolkitdfsp"
              }
            },
            "payee": {
              "partyIdInfo": {
                "partyIdType": "MSISDN",
                "partyIdentifier": "0999999999",
                "fspId": "dfsp-b"
              }
            },
            "amountType": "SEND",
            "amount": {
              "currency": "USD",
              "amount": "100"
            },
            "transactionType": {
              "scenario": "TRANSFER",
              "initiator": "PAYER",
              "initiatorType": "CONSUMER"
            }
          },
          "url": "http://host.docker.internal:3000",
          "tests": {
            "assertions": [
              {
                "id": 1,
                "description": "Response status to be 202",
                "exec": [
                  "expect(response.status).to.equal(202)"
                ]
              },
              {
                "id": 2,
                "description": "Error code to be 3200",
                "exec": [
                  "expect(callback.body.errorInformation.errorCode).to.equal('3200')"
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}
