# Server Configuration
PORT=3000
NODE_ENV=development

# Mojaloop Participant Identity
FSPIOP_DFSP_ID=dfsp-b
DEFAULT_CURRENCY=USD

# Mojaloop Hub / Testing Toolkit (TTK) Connection
HUB_BASE_URL=http://localhost:4040
CALLBACK_TIMEOUT_MS=5000

# Transaction Business Rules
QUOTE_EXPIRY_SECONDS=60

# Security / JWS (JSON Web Signature) Non-repudiation
FSPIOP_JWS_PRIVATE_KEY_PATH="./certs/jws/dfsp-jws-private.pem"
FSPIOP_JWS_PUBLIC_KEY_PATH="./certs/jws/dfsp-jws-public.pem"
FSPIOP_JWS_ALGORITHM=RS256

# TLS / mTLS Configuration
TLS_ENABLED=false
TLS_SERVER_KEY_PATH="./certs/tls/server/server.key"
TLS_SERVER_CERT_PATH="./certs/tls/server/server.crt"
TLS_SERVER_CA_PATH="./certs/tls/server/dfsp_ca.crt"

TLS_CLIENT_KEY_PATH="./certs/tls/client/client.key"
TLS_CLIENT_CERT_PATH="./certs/tls/client/client.crt"
TLS_CLIENT_CA_PATH="./certs/tls/client/ca.crt"
HUB_TLS_REJECT_UNAUTHORIZED=false
